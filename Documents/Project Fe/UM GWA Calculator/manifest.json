{
  "manifest_version": 3,
  "name": "GWA Gah?",
  "short_name": "GWA Gah",
  "version": "2.2.0",
  "description": "A clean GWA academic snapshot for UM Davao students with automatic grade-scale detection.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon128.png",
        "icons/feanne-logo-blue.png"
      ],
      "matches": [
        "https://student.umindanao.edu.ph/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://student.umindanao.edu.ph/student/spr*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
